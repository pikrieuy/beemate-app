{
  "enabled": true,
  "name": "TypeScript Check on Save",
  "description": "Automatically runs TypeScript type checking when a .ts or .tsx file is edited, catching errors before they reach production.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*.ts",
      "*.tsx"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "npx tsc --noEmit 2>&1 | head -20",
    "timeout": 30
  }
}