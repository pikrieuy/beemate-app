// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

// ==========================================
// 1. NEXTAUTH / AUTH.JS STANDARD MODELS
// ==========================================

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==========================================
// 2. BEEMATE CORE MODELS
// ==========================================

enum UserRole {
  USER
  ADMIN
}

enum JoinStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum NotificationType {
  INVITE
  ACCEPT
  ALERT
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(USER)
  
  // Profil BeeMate
  bio           String?   @db.Text
  skills        String[]  // Fitur array didukung secara native oleh PostgreSQL
  title         String?   // Hacker, Hustler, atau Hipster
  portfolioUrl  String?

  // Relasi NextAuth
  accounts      Account[]
  sessions      Session[]

  // Relasi BeeMate
  teamsCreated  Team[]         @relation("TeamLeader")
  teamMembers   TeamMember[]
  competitions  Competition[]  @relation("CompetitionAuthor")
  
  notificationsReceived Notification[] @relation("Recipient")
  notificationsSent     Notification[] @relation("Sender")
  endorsementsSent     Endorsement[] @relation("EndorsementSender")
  endorsementsReceived Endorsement[] @relation("EndorsementRecipient")
  messages             Message[]
  assignedTasks        Task[]
  projects             Project[]
  projectComments      ProjectComment[]
  projectLikes         ProjectLike[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Team {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  
  leaderId    String
  leader      User     @relation("TeamLeader", fields: [leaderId], references: [id])
  
  members     TeamMember[]
  messages    Message[]
  tasks       Task[]
  project     Project?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TeamMember {
  id         String     @id @default(cuid())
  teamId     String
  userId     String
  role       String     @default("MEMBER") // ADMIN_TIM atau MEMBER
  joinStatus JoinStatus @default(PENDING)

  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
  
  @@unique([teamId, userId]) // Mencegah 1 user masuk tim yg sama 2 kali
}

model Competition {
  id               String   @id @default(cuid())
  title            String
  description      String   @db.Text
  imageUrl         String?
  registrationLink String?
  deadline         DateTime?
  
  authorId         String
  author           User     @relation("CompetitionAuthor", fields: [authorId], references: [id])

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Notification {
  id          String           @id @default(cuid())
  
  recipientId String
  recipient   User             @relation("Recipient", fields: [recipientId], references: [id], onDelete: Cascade)
  
  senderId    String?
  sender      User?            @relation("Sender", fields: [senderId], references: [id], onDelete: SetNull)
  
  type        NotificationType
  message     String           @db.Text
  isRead      Boolean          @default(false)

  createdAt   DateTime         @default(now())
}

model Endorsement {
  id          String   @id @default(cuid())
  senderId    String
  sender      User     @relation("EndorsementSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User     @relation("EndorsementRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  skill       String   // The skill tag being endorsed
  createdAt   DateTime @default(now())

  @@unique([senderId, recipientId, skill])
}

model Message {
  id        String   @id @default(cuid())
  content   String   @db.Text
  createdAt DateTime @default(now())
  
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([senderId])
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?   @db.Text
  status      String    @default("TODO") // "TODO", "IN_PROGRESS", "DONE"
  priority    String    @default("MEDIUM") // "LOW", "MEDIUM", "HIGH"
  dueDate     DateTime?
  
  teamId      String
  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  
  assigneeId  String?
  assignee    User?     @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([teamId])
  @@index([assigneeId])
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  imageUrl    String?
  demoUrl     String?
  githubUrl   String?
  
  teamId      String?  @unique
  team        Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  
  userId      String   // Creator
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  comments    ProjectComment[]
  likes       ProjectLike[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model ProjectComment {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([userId])
}

model ProjectLike {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}
